\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-stage accounting for both paths at $N{=}512$. The last column is the fraction of whichever machine limit binds the stage, and it separates a stage that is badly implemented from one doing the only thing its access pattern permits. A figure above $100\%$ marks a stage whose working set is served from cache, so that its analytic byte count is not traffic to memory; those stages are the small ones, and none carries an argument. Peak measured on the same device: 57.8~TFLOP/s and 1497~GB/s, a ridge point of 39~FLOP/byte.}}{12}{table.3}\protected@file@percent }
\newlabel{tab:stages}{{3}{12}{Per-stage accounting for both paths at $N{=}\StagesN $. The last column is the fraction of whichever machine limit binds the stage, and it separates a stage that is badly implemented from one doing the only thing its access pattern permits. A figure above $100\%$ marks a stage whose working set is served from cache, so that its analytic byte count is not traffic to memory; those stages are the small ones, and none carries an argument. \StagesCaption }{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Left:} how each path divides its time. Selection grows to dominate the gathered path as the agent count rises. \textbf  {Right:} how close each stage runs to the machine limit that binds it.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:stages}{{3}{12}{\textbf {Left:} how each path divides its time. Selection grows to dominate the gathered path as the agent count rises. \textbf {Right:} how close each stage runs to the machine limit that binds it}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Forward, backward and their sum, for the differentiable implementations. The sparse path's backward is cheap relative to its forward, because selection has almost no adjoint, so the gap against fused dense narrows without closing.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:backward}{{4}{13}{Forward, backward and their sum, for the differentiable implementations. The sparse path's backward is cheap relative to its forward, because selection has almost no adjoint, so the gap against fused dense narrows without closing}{table.4}{}}
