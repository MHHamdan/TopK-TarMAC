    "per_agent_reward": true,
    "lagrangian_k": false,
    "kappa_frac": 0.25,
    "lambda_lr": 0.01,
    "lambda_init": 0.0,
    "lambda_max": 100.0,
    "log_interval_steps": 4000,
    "eval_interval_steps": 40000,
    "eval_episodes": 32,
    "device": "cuda",
    "run_name": "red_po6_gather_k2",
    "out_dir": "results"
