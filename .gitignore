# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp
.claude/

# --- Run-time / logging artefacts ---
wandb/
tb_logs/
runs/
*.log

# --- Trained checkpoints (large binaries; full reproducibility comes from
#     metrics.csv + config.json + final_eval.json, all of which ARE tracked) ---
results/**/*.pt
results/**/*.ckpt
results/**/checkpoints/

# --- Large data directories (untracked by default; populate locally) ---
data/raw/
data/processed/
data/*.zip
data/*.tar*

# --- Paper artefacts ---
# Manuscript SOURCES are tracked so the paper has revision history (AUDIT.md
# D-16: previously the whole of paper/ was ignored, so no manuscript revision
# existed in git at all). LaTeX build intermediates and the compiled PDF are
# not tracked -- they are regenerable via `make paper`.
#
# NOTE: `origin` is a GitHub remote and paper/ was deliberately untracked in
# 6f796c2 for privacy. These commits are local-only; do not push without
# confirming the manuscript may become public (DECISIONS.md D-013).
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.log
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/main.pdf
PAPER_PROMPT.md

# --- Internal planning artefacts (private; not pushed) ---
proposals/
STATUS.md

# --- Literature PDFs (license-uncertain; notes + bib are tracked) ---
literature/papers/*.pdf
